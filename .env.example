# Local PostgreSQL connection string. Create the database first, e.g.:
#   createdb playground_qa
DATABASE_URL="postgresql://YOUR_MACOS_USERNAME@localhost:5432/playground_qa?schema=public"

# Any random string in development. Use a long random value in production.
JWT_SECRET="dev-only-change-me-in-production-8f2c9a1e4b7d"
JWT_EXPIRES_IN="7d"

# Origin allowed to call this API with CORS. Must match the frontend's dev URL.
FRONTEND_ORIGIN="http://localhost:5173"

PORT=4000
