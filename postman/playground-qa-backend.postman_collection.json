{
  "info": {
    "_postman_id": "a1e6b8c2-5c3a-4e5a-9b0f-2d4a7f1c9e88",
    "name": "QA Playground Shop API",
    "description": "Backend for the QA Playground Shop frontend: login through checkout, payment, and order history. Import the companion environment (playground-qa-backend.postman_environment.json) and run requests top to bottom — Login captures {{token}} automatically for every protected request below it.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane@example.com\",\n  \"password\": \"Password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Login (seeded QA user)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('token present', () => pm.expect(body.token).to.be.a('string'));",
                  "if (body.token) pm.environment.set('token', body.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"qa@playground.test\",\n  \"password\": \"Password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?q=&category=&sort=&minPrice=&maxPrice=",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "q", "value": "", "description": "Case-insensitive name search" },
                { "key": "category", "value": "", "description": "e.g. Electronics" },
                { "key": "sort", "value": "", "description": "price-asc | price-desc | name-asc | name-desc | rating-desc" },
                { "key": "minPrice", "value": "" },
                { "key": "maxPrice", "value": "" }
              ]
            }
          }
        },
        {
          "name": "List categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/products/categories", "host": ["{{baseUrl}}"], "path": ["products", "categories"] }
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Pay with credit card (success)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"credit-card\",\n  \"card\": {\n    \"number\": \"4111 1111 1111 1111\",\n    \"name\": \"QA Tester\",\n    \"expiry\": \"12/30\",\n    \"cvv\": \"123\"\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/payments", "host": ["{{baseUrl}}"], "path": ["payments"] }
          }
        },
        {
          "name": "Pay with credit card (declined)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"credit-card\",\n  \"card\": {\n    \"number\": \"4000 0000 0000 0002\",\n    \"name\": \"QA Tester\",\n    \"expiry\": \"12/30\",\n    \"cvv\": \"123\"\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/payments", "host": ["{{baseUrl}}"], "path": ["payments"] }
          }
        },
        {
          "name": "Pay with GoPay",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "body": { "mode": "raw", "raw": "{\n  \"method\": \"gopay\"\n}" },
            "url": { "raw": "{{baseUrl}}/payments", "host": ["{{baseUrl}}"], "path": ["payments"] }
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "if (body.id) pm.environment.set('orderId', body.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"product\": { \"id\": 1, \"name\": \"Wireless Mouse\", \"price\": 150000 }, \"quantity\": 2 }\n  ],\n  \"shipping\": {\n    \"fullName\": \"QA Tester\",\n    \"phone\": \"081234567890\",\n    \"address\": \"Jl. Test No. 1\",\n    \"city\": \"Jakarta\",\n    \"postalCode\": \"12345\"\n  },\n  \"payment\": {\n    \"method\": \"credit-card\",\n    \"status\": \"paid\",\n    \"paidAt\": \"2026-01-01T00:00:00.000Z\"\n  },\n  \"totals\": {\n    \"subtotal\": 300000,\n    \"shippingFee\": 15000,\n    \"grandTotal\": 315000\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/orders", "host": ["{{baseUrl}}"], "path": ["orders"] }
          }
        },
        {
          "name": "List my orders",
          "request": {
            "method": "GET",
            "header": [],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "url": { "raw": "{{baseUrl}}/orders", "host": ["{{baseUrl}}"], "path": ["orders"] }
          }
        },
        {
          "name": "Get order by id",
          "request": {
            "method": "GET",
            "header": [],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "url": { "raw": "{{baseUrl}}/orders/{{orderId}}", "host": ["{{baseUrl}}"], "path": ["orders", "{{orderId}}"] }
          }
        }
      ]
    }
  ],
  "variable": [{ "key": "baseUrl", "value": "http://localhost:4000/api" }]
}
